<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_autosave</name>
	<author>Joomla! Project</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>6.2.0</version>
	<description>PLG_SYSTEM_AUTOSAVE_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\System\Autosave</namespace>
	<files>
		<folder plugin="autosave">services</folder>
		<folder>src</folder>
	</files>
	<media destination="com_autosave" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>js</folder>
	</media>
	<languages>
		<language tag="en-GB">language/en-GB/plg_system_autosave.ini</language>
		<language tag="en-GB">language/en-GB/plg_system_autosave.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="interval" type="number" label="PLG_SYSTEM_AUTOSAVE_CONFIG_INTERVAL_LABEL" description="PLG_SYSTEM_AUTOSAVE_CONFIG_INTERVAL_DESC" default="30" min="1" step="1" filter="integer" validate="number"/>
			</fieldset>
		</fields>
	</config>
</extension>
